<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10 and 11: those versions can't tell a cloud backup from a phone-to-phone move, so neither
     takes anything. Attic's own backup to a folder covers both. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
